# Leaderboard API configuration
PORT=3001
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://yeongseon.github.io

# Storage: "memory" (default, non-persistent) or "file" (persistent)
LEADERBOARD_STORAGE=file
LEADERBOARD_FILE_PATH=./data/leaderboard.json

# Set to "true" only when behind a trusted reverse proxy
TRUST_PROXY=false

# Optional Export to Azure: server only. Never use VITE_ for these values.
# Resource origin, e.g. https://<resource>.openai.azure.com (no /openai path)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
# Deployment name for a Responses + Structured Outputs capable model
AZURE_OPENAI_DEPLOYMENT=
# Leave empty for GA /openai/v1/responses. Compatibility override only.
AZURE_OPENAI_API_VERSION=
