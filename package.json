{
  "name": "stack-and-survive",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": { "node": ">=22.12.0 <23" },
  "scripts": {
    "dev": "pnpm --filter @stack-and-survive/web dev",
    "lint": "eslint \"apps/web/src/**/*.{ts,tsx}\" \"packages/*/src/**/*.{ts,tsx}\" --no-error-on-unmatched-pattern",
    "typecheck": "tsc --noEmit && pnpm --filter @stack-and-survive/leaderboard-api typecheck",
    "test": "vitest run",
    "check:assets": "node scripts/asset-manifest.mjs",
    "check:assets:release": "node scripts/asset-manifest.mjs --release",
    "test:assets": "node --test scripts/asset-manifest.test.mjs",
    "check:assets:v3": "node art/v3/check-runtime.mjs",
    "test:art": "node --test art/v3/core-facilities.test.mjs art/v3/environment-kit.test.mjs",
    "build": "pnpm --filter @stack-and-survive/web build",
    "build:pages": "pnpm --filter @stack-and-survive/web exec vite build --base /stack-and-survive/ --outDir dist-pages",
    "test:pages": "playwright test --config playwright.pages.config.ts",
    "check:assets:demo": "node scripts/check-pages-demo.mjs",
    "build:qa": "pnpm --filter @stack-and-survive/web build:qa",
    "test:browser": "playwright test",
    "test:player": "playwright test --config playwright.player.config.ts",
    "test:release": "playwright test --config playwright.release.config.ts",
    "test:performance": "playwright test --config playwright.performance.config.ts",
    "capture:submission": "pnpm build && node scripts/capture-submission.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "eslint": "^9.39.0",
    "typescript-eslint": "^8.50.0",
    "typescript": "5.9.3",
    "vitest": "4.1.11",
    "@playwright/test": "1.63.0"
  }
}
