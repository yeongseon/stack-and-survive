{
  "name": "stack-and-survive",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": { "node": ">=22.12.0 <23" },
  "scripts": {
    "dev": "pnpm --filter @stack-and-survive/web dev",
    "lint": "eslint \"apps/web/src/**/*.{ts,tsx}\" \"packages/*/src/**/*.{ts,tsx}\" --no-error-on-unmatched-pattern",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "pnpm --filter @stack-and-survive/web build",
    "build:qa": "pnpm --filter @stack-and-survive/web build:qa",
    "test:browser": "playwright test",
    "test:player": "playwright test --config playwright.player.config.ts",
    "test:performance": "playwright test --config playwright.performance.config.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "eslint": "^9.39.0",
    "typescript-eslint": "^8.50.0",
    "typescript": "5.9.3",
    "vitest": "4.1.11",
    "@playwright/test": "1.63.0"
  }
}
